#!/usr/bin/env bash

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
# shellcheck source=/dev/null
source "${CAPTURE_LIB:-$HOME/dotfiles/bin/src/capture.bash}"

failures=0
sandbox="$(mktemp -d)"

# shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap.
cleanup() {
	# This directory is created by this test under TMPDIR and contains no user data.
	rm -rf "$sandbox"
}
trap cleanup EXIT

pass() {
	printf 'PASS: %s\n' "$1"
}

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	failures=$((failures + 1))
}

assert_contains() {
	local label="$1" needle="$2" value="$3"
	case "$value" in
		*"$needle"*) pass "$label" ;;
		*) fail "$label: missing $needle" ;;
	esac
}

out='' err='' rc=0
capture "$ROOT/install" --help
if [ "$rc" -ne 0 ]; then
	fail "installer help exited $rc"
else
	assert_contains 'installer help documents Codex mode' '--codex' "$out"
	assert_contains 'installer help names the canonical Codex root' '.agents/skills' "$out"
fi

out='' err='' rc=0
capture "$ROOT/install" --not-an-option
if [ "$rc" -ne 64 ]; then
	fail "installer invalid option exited $rc, expected 64"
else
	assert_contains 'installer invalid option shows usage' 'Usage:' "$err"
fi

home="$sandbox/home"
out='' err='' rc=0
# shellcheck disable=SC2016 # Positional parameters belong to the child Bash.
capture bash -c 'printf "yes\\n" | HOME="$1" "$2/install" --codex' _ "$home" "$ROOT"
if [ "$rc" -ne 0 ]; then
	fail "Codex install exited $rc: $err"
else
	assert_contains 'Codex install reports success' 'failed=0' "$out"
	if [ ! -L "$home/.agents/skills" ]; then
		fail 'Codex install links its canonical user skill root'
	elif [ "$(readlink "$home/.agents/skills")" != "$ROOT" ]; then
		fail 'Codex install links its canonical user skill root to this repository'
	elif [ ! -f "$home/.agents/skills/i18n/SKILL.md" ]; then
		fail 'Codex install exposes i18n through the repository link'
	else
		pass 'Codex install exposes shared skills through one repository link'
	fi
fi

if [ -f "$home/.agents/skills/mechatron-ci/SKILL.md" ] && [ -f "$home/.agents/skills/mechatron-ci/agents/openai.yaml" ]; then
	pass 'Codex install includes the shared Mechatron skill'
else
	fail 'Codex install includes the shared Mechatron skill'
fi

if [ -f "$home/.agents/skills/capture-collaboration-evidence/SKILL.md" ] &&
	[ -f "$home/.agents/skills/capture-collaboration-evidence/agents/openai.yaml" ]; then
	pass 'Codex install includes the collaboration-evidence skill and UI metadata'
else
	fail 'Codex install includes the collaboration-evidence skill and UI metadata'
fi
if grep -Fq 'allow_implicit_invocation: true' \
	"$home/.agents/skills/capture-collaboration-evidence/agents/openai.yaml"; then
	pass 'collaboration-evidence skill explicitly permits implicit invocation'
else
	fail 'collaboration-evidence skill explicitly permits implicit invocation'
fi

out='' err='' rc=0
# shellcheck disable=SC2016 # Positional parameters belong to the child Bash.
capture bash -c 'printf "yes\\n" | HOME="$1" "$2/install" --codex' _ "$home" "$ROOT"
if [ "$rc" -ne 0 ]; then
	fail "repeat Codex install exited $rc: $err"
else
	assert_contains 'repeat Codex install reuses the canonical link' 'already points to this repository' "$out"
fi

exit "$failures"
