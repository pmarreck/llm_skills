#!/usr/bin/env bash

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
source "$HOME/dotfiles/bin/src/capture.bash"

failures=0
sandbox="$(mktemp -d)"
repo="$sandbox/llm_skills"
home="$sandbox/home"

cleanup() {
	# This directory is created by this test under TMPDIR and contains no user data.
	rm -rf "$sandbox"
}
trap cleanup EXIT

pass() {
	printf 'PASS: %s\n' "$1"
}

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	failures=$((failures + 1))
}

assert_contains() {
	local label="$1" needle="$2" value="$3"
	case "$value" in
		*"$needle"*) pass "$label" ;;
		*) fail "$label: missing $needle" ;;
	esac
}

cp -pRP "$ROOT/." "$repo"
# The shared repository deliberately links this skill to Peter's private
# context outside the repository. Materialize it only in the RAM test fixture.
rm "$repo/about-peter/SKILL.md"
cp -pL "$ROOT/about-peter/SKILL.md" "$repo/about-peter/SKILL.md"

out='' err='' rc=0
capture bash -c 'HOME="$1" "$2/install" --codex --sync' _ "$home" "$repo"
if [ "$rc" -ne 0 ]; then
	fail "Codex sync exited $rc: $err"
else
	assert_contains 'Codex sync is noninteractive' 'Mode: sync (noninteractive)' "$out"
	assert_contains 'Codex sync announces hook installation' 'hooks live at' "$out"
fi

hook_path="$repo/.githooks/post-checkout"
if [ ! -x "$hook_path" ]; then
	fail 'Codex sync installs an executable post-checkout hook'
else
	pass 'Codex sync installs an executable post-checkout hook'
fi

hooks_path="$(git -C "$repo" config --local --get core.hooksPath 2>/dev/null || true)"
if [ "$hooks_path" = '.githooks' ]; then
	pass 'Codex sync configures this repository hook path only'
else
	fail "Codex sync hook path was $hooks_path, expected .githooks"
fi

if [ -f "$home/.codex/skills/mechatron-ci/SKILL.md" ]; then
	pass 'Codex sync materializes the Mechatron skill'
else
	fail 'Codex sync materializes the Mechatron skill'
fi

mkdir -p "$home/.codex/skills/local-only"
printf '%s\n' local-only > "$home/.codex/skills/local-only/SKILL.md"
printf '\n<!-- hook-sync-fixture -->\n' >> "$repo/mechatron-ci/SKILL.md"

out='' err='' rc=0
capture env HOME="$home" "$hook_path" before after 1
if [ "$rc" -ne 0 ]; then
	fail "post-checkout hook exited $rc: $err"
else
	assert_contains 'post-checkout announces that it is running' 'post-checkout hook running from' "$out"
	assert_contains 'post-checkout states its installed location' "$hook_path" "$out"
fi

if rg -q 'hook-sync-fixture' "$home/.codex/skills/mechatron-ci/SKILL.md"; then
	pass 'hook refreshes an updated managed skill'
else
	fail 'hook refreshes an updated managed skill'
fi

if [ -f "$home/.codex/skills/local-only/SKILL.md" ]; then
	pass 'hook preserves a local-only Codex skill'
else
	fail 'hook preserves a local-only Codex skill'
fi

backup_path="$(find "$home/.codex/backups" -type d -name 'llm-skills-sync.*' -print -quit 2>/dev/null || true)"
if [ -n "$backup_path" ] && [ -f "$backup_path/mechatron-ci/SKILL.md" ]; then
	pass 'hook retains a recoverable managed-skill backup'
else
	fail 'hook retains a recoverable managed-skill backup'
fi

if rg -q -- '--link|-printf|cp -a' "$repo/install"; then
	fail 'Codex sync avoids GNU-only copy and find options'
else
	pass 'Codex sync avoids GNU-only copy and find options'
fi

exit "$failures"
