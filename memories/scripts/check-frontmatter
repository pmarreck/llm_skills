#!/usr/bin/env bash

# Validate memory frontmatter without reading bodies or generated search indexes.

set -u

mode=check
failures=0

usage() {
	printf '%s\n' 'Usage: check-frontmatter [--headers] MEMORY_ROOT_OR_FILE...'
	printf '%s\n' 'Validate *.frontmatter.md files with description, datetime, and tags metadata.'
}

report_failure() {
	printf '%s: %s\n' "$1" "$2" >&2
	failures=$((failures + 1))
}

is_timezone_aware_datetime() {
	printf '%s\n' "$1" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$'
}

is_valid_tags() {
	printf '%s\n' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]*(, [a-z0-9][a-z0-9-]*)*$'
}

check_file() {
	local file="$1" base first line closed=0 description='' datetime='' tags=''
	local description_count=0 datetime_count=0 tags_count=0 value tag_contents

	base=${file##*/}
	# Skip VCS scaffolding that legitimately lives in a synced (Git) memory
	# root: hidden files (.gitignore, .gitattributes, .DS_Store) and common
	# repository docs. Genuine memories and legacy noise are neither hidden nor
	# in this allowlist, so they are still validated or flagged below.
	case "$base" in
		.*) return ;;
		README.md|LICENSE|LICENSE.md|LICENSE.txt|COPYING) return ;;
	esac
	case "$base" in
		*.frontmatter.md) ;;
		*)
			report_failure "$file" 'filename must end in .frontmatter.md'
			return
			;;
	esac

	IFS= read -r first < "$file" || first=''
	if [ "$first" != '---' ]; then
		report_failure "$file" 'frontmatter must begin on line 1 with ---'
		return
	fi

	while IFS= read -r line; do
		if [ "$line" = '---' ]; then
			closed=1
			break
		fi
		case "$line" in
			description:*)
				description_count=$((description_count + 1))
				description=${line#description: }
				;;
			datetime:*)
				datetime_count=$((datetime_count + 1))
				datetime=${line#datetime: }
				;;
			tags:*)
				tags_count=$((tags_count + 1))
				tags=${line#tags: }
				;;
			date:*)
				report_failure "$file" 'use datetime, not date'
				;;
			'')
				report_failure "$file" 'frontmatter must not contain blank fields'
				;;
			*)
				report_failure "$file" "unexpected frontmatter field: ${line%%:*}"
				;;
		esac
	done < <(awk 'NR > 1 { print; if ($0 == "---") exit }' "$file")

	if [ "$closed" -ne 1 ]; then
		report_failure "$file" 'frontmatter is missing its closing ---'
		return
	fi
	if [ "$description_count" -ne 1 ]; then
		report_failure "$file" 'frontmatter must contain exactly one description'
	elif ! printf '%s\n' "$description" | grep -Eq '^".+"$'; then
		report_failure "$file" 'description must be a non-empty quoted string'
	fi
	if [ "$datetime_count" -ne 1 ]; then
		report_failure "$file" 'frontmatter must contain exactly one datetime'
	else
		value=${datetime%% #*}
		if ! is_timezone_aware_datetime "$value"; then
			report_failure "$file" 'datetime must be a timezone-aware ISO 8601 value'
		fi
	fi
	if [ "$tags_count" -ne 1 ]; then
		report_failure "$file" 'frontmatter must contain exactly one tags field'
	else
		case "$tags" in
			\[*\])
				tag_contents=${tags#\[}
				tag_contents=${tag_contents%\]}
				if ! is_valid_tags "$tag_contents"; then
					report_failure "$file" 'tags must be a non-empty lowercase flow list'
				fi
				;;
			*) report_failure "$file" 'tags must be a non-empty lowercase flow list' ;;
		esac
	fi

	if [ "$mode" = headers ] && [ "$description_count" -eq 1 ] && [ "$datetime_count" -eq 1 ] && [ "$tags_count" -eq 1 ]; then
		printf '%s\t%s\t%s\t%s\n' "$file" "$description" "$datetime" "$tags"
	fi
}

check_path() {
	local path="$1" file
	if [ -f "$path" ]; then
		check_file "$path"
	elif [ -d "$path" ]; then
		while IFS= read -r file; do
			[ -n "$file" ] || continue
			check_file "$file"
		done < <(command find "$path" -type d \( -name .git -o -name .codescan \) -prune -o -type f -print)
	else
		report_failure "$path" 'does not exist or is not a regular file or directory'
	fi
}

if [ "${1:-}" = '--headers' ]; then
	mode=headers
	shift
elif [ "${1:-}" = '--help' ] || [ "${1:-}" = '-h' ]; then
	usage
	exit 0
fi

if [ "$#" -eq 0 ]; then
	usage >&2
	exit 64
fi

for path in "$@"; do
	check_path "$path"
done

exit "$failures"
