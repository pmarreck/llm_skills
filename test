#!/usr/bin/env bash

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
failures=0

if "$ROOT/tests/cli/test_install"; then
	printf 'PASS: installer integration\n'
else
	printf 'FAIL: installer integration\n' >&2
	failures=$((failures + 1))
fi

if [ -f "$ROOT/MECHATRON_PRIME_CI.md" ] && [ ! -L "$ROOT/MECHATRON_PRIME_CI.md" ]; then
	printf 'PASS: Mechatron policy is a portable regular file\n'
else
	printf 'FAIL: Mechatron policy must be a regular tracked file\n' >&2
	failures=$((failures + 1))
fi

if [ -f "$ROOT/mechatron-ci/SKILL.md" ] && [ -f "$ROOT/mechatron-ci/agents/openai.yaml" ]; then
	printf 'PASS: Mechatron skill is shared with both agents\n'
else
	printf 'FAIL: Mechatron skill must include its instructions and UI metadata\n' >&2
	failures=$((failures + 1))
fi

if git -C "$ROOT" check-ignore -q .system/example/SKILL.md; then
	printf 'PASS: Codex bundled skills stay out of the shared repository\n'
else
	printf 'FAIL: Codex bundled skills must be ignored by the shared repository\n' >&2
	failures=$((failures + 1))
fi

if "$ROOT/tests/cli/test_codex_sync"; then
	printf 'PASS: Codex hook sync integration\n'
else
	printf 'FAIL: Codex hook sync integration\n' >&2
	failures=$((failures + 1))
fi

if "$ROOT/tests/cli/test_memories"; then
	printf 'PASS: memory frontmatter skill integration\n'
else
	printf 'FAIL: memory frontmatter skill integration\n' >&2
	failures=$((failures + 1))
fi

if "$ROOT/tests/cli/test_memory_titles"; then
	printf 'PASS: memory title browser integration\n'
else
	printf 'FAIL: memory title browser integration\n' >&2
	failures=$((failures + 1))
fi

exit "$failures"
