#!/usr/bin/env bash
# install — install this llm_skills clone for local agent harnesses.
#
# Default: symlink this clone to ~/.claude/skills for Claude Code.
# Codex: run `./install --codex`; Codex currently skips symlinked skill
# directories and symlinked SKILL.md files, so the Codex path creates real
# directories under ~/.codex/skills and dereferences skill sources.

set -uo pipefail
set -E
trap 'printf "\ninstall: failure on line %s\n" "$LINENO" >&2; exit 1' ERR

# Resolve the real directory of this script, regardless of where it was
# invoked from (and even if the caller used a symlink).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

usage() {
    cat <<EOF
Usage: ./install [--claude|--codex|--help]

  --claude  Symlink this repo to ~/.claude/skills (default)
  --codex         Install missing skills into ~/.codex/skills as real directories
  --codex --sync  Refresh shared Codex skills and configure this repo's Git hooks
EOF
}

list_skill_dirs() {
	find -L "$SCRIPT_DIR" -mindepth 2 -maxdepth 2 -name SKILL.md -exec dirname {} \; | sort -u
}

stage_skill() {
	local skill_dir="$1" target="$2" name staging staged
	name=${skill_dir##*/}
	if ! staging="$(mktemp -d "$target/.${name}.install.XXXXXX")"; then
		return 1
	fi
	staged="$staging/$name"
	if ! cp -pRL "$skill_dir" "$staged"; then
		# `staging` was made by mktemp under the resolved Codex skills directory.
		rm -rf "$staging"
		return 1
	fi
	printf '%s\n' "$staging"
}

configure_repo_hooks() {
	if ! git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		printf 'Failed to configure hooks: %s is not a Git worktree\n' "$SCRIPT_DIR" >&2
		return 1
	fi
	if ! git -C "$SCRIPT_DIR" config --local core.hooksPath .githooks; then
		printf 'Failed to configure repository-local hook path\n' >&2
		return 1
	fi
	printf 'Configured repository-local hook path: .githooks (hooks live at %s/.githooks)\n' "$SCRIPT_DIR"
}

install_missing_codex_skills() {
	local target="$HOME/.codex/skills"
	local skill_dir name dest staging staged
	local installed=0 skipped=0 failed=0

    printf '\n'
    printf 'llm_skills Codex installer\n'
    printf '==========================\n'
    printf 'Source (this repo):  %s\n' "$SCRIPT_DIR"
    printf 'Target directory:    %s\n' "$target"
    printf '\n'
	printf 'Plan:\n'
	printf '  - Create %s if needed.\n' "$target"
	printf '  - Install missing skills as real directories.\n'
	printf '  - Copy files portably and dereference symlinked sources.\n'
	printf '  - Leave existing skill directories untouched.\n'
    printf '\n'
    printf 'Proceed? [y/N] '
    read -r reply
    case "${reply:-}" in
        y|Y|yes|YES) ;;
        *)
            printf 'Aborted.\n' >&2
            exit 1
            ;;
    esac

    mkdir -p "$target"

    while IFS= read -r skill_dir; do
        name=${skill_dir##*/}
        dest="$target/$name"

        if [ ! -e "$skill_dir/SKILL.md" ]; then
            printf 'Skipped unavailable skill (source could not be materialized): %s\n' "$name" >&2
            skipped=$((skipped + 1))
            continue
        fi

        if [ -e "$dest" ] || [ -L "$dest" ]; then
            printf 'Skipped existing skill: %s\n' "$name"
            skipped=$((skipped + 1))
            continue
        fi

		if ! staging="$(stage_skill "$skill_dir" "$target")"; then
			printf 'Failed to prepare skill: %s\n' "$name" >&2
			failed=$((failed + 1))
			continue
		fi
		staged="$staging/$name"

		if mv "$staged" "$dest"; then
			rmdir "$staging"
			printf 'Installed skill: %s (copied)\n' "$name"
			installed=$((installed + 1))
		else
			rm -rf "$staging"
			printf 'Failed skill: %s\n' "$name" >&2
			failed=$((failed + 1))
		fi
	done < <(list_skill_dirs)

    printf '\nSummary: installed=%d skipped=%d failed=%d\n' "$installed" "$skipped" "$failed"
    if [ "$failed" -ne 0 ]; then
        exit 1
	fi
	printf 'Done. Restart Codex sessions to pick up newly-installed skills.\n'
}

sync_codex_skills() {
	local target="$HOME/.codex/skills"
	local backup_parent="$HOME/.codex/backups"
	local backup_root=''
	local skill_dir name dest staging staged diff_rc
	local installed=0 refreshed=0 unchanged=0 skipped=0 failed=0

	mkdir -p "$target"
	printf '\n'
	printf 'llm_skills Codex sync\n'
	printf '======================\n'
	printf 'Source skills: %s\n' "$SCRIPT_DIR"
	printf 'Target directory: %s\n' "$target"
	printf 'Mode: sync (noninteractive)\n'

	while IFS= read -r skill_dir; do
		name=${skill_dir##*/}
		dest="$target/$name"

		if [ ! -e "$skill_dir/SKILL.md" ]; then
			printf 'Skipped unavailable skill (source could not be materialized): %s\n' "$name" >&2
			skipped=$((skipped + 1))
			continue
		fi

		if [ -e "$dest" ] || [ -L "$dest" ]; then
			if diff -qr "$skill_dir" "$dest" >/dev/null 2>&1; then
				diff_rc=0
			else
				diff_rc=$?
			fi
			if [ "$diff_rc" -eq 0 ]; then
				printf 'Unchanged skill: %s\n' "$name"
				unchanged=$((unchanged + 1))
				continue
			fi
			if [ "$diff_rc" -ne 1 ]; then
				printf 'Failed to compare skill: %s\n' "$name" >&2
				failed=$((failed + 1))
				continue
			fi
		fi

		if ! staging="$(stage_skill "$skill_dir" "$target")"; then
			printf 'Failed to stage skill: %s\n' "$name" >&2
			failed=$((failed + 1))
			continue
		fi
		staged="$staging/$name"

		if [ -e "$dest" ] || [ -L "$dest" ]; then
			if [ -z "$backup_root" ]; then
				mkdir -p "$backup_parent"
				if ! backup_root="$(mktemp -d "$backup_parent/llm-skills-sync.XXXXXX")"; then
					rm -rf "$staging"
					printf 'Failed to create a recoverable backup directory\n' >&2
					failed=$((failed + 1))
					continue
				fi
			fi
			if ! mv "$dest" "$backup_root/$name"; then
				rm -rf "$staging"
				printf 'Failed to preserve existing skill: %s\n' "$name" >&2
				failed=$((failed + 1))
				continue
			fi
			if mv "$staged" "$dest"; then
				rmdir "$staging"
				printf 'Refreshed skill: %s\n' "$name"
				refreshed=$((refreshed + 1))
			else
				mv "$backup_root/$name" "$dest"
				rm -rf "$staging"
				printf 'Failed to refresh skill: %s (restored its previous copy)\n' "$name" >&2
				failed=$((failed + 1))
			fi
		else
			if mv "$staged" "$dest"; then
				rmdir "$staging"
				printf 'Installed skill: %s\n' "$name"
				installed=$((installed + 1))
			else
				rm -rf "$staging"
				printf 'Failed to install skill: %s\n' "$name" >&2
				failed=$((failed + 1))
			fi
		fi
	done < <(list_skill_dirs)

	printf '\nSummary: installed=%d refreshed=%d unchanged=%d skipped=%d failed=%d\n' "$installed" "$refreshed" "$unchanged" "$skipped" "$failed"
	if [ -n "$backup_root" ]; then
		printf 'Recoverable previous copies: %s\n' "$backup_root"
	fi
	if [ "$failed" -ne 0 ]; then
		return 1
	fi
}

case "${1:---claude}" in
	--help|-h)
		usage
		exit 0
		;;
	--codex)
		shift
		sync=0
		from_hook=0
		while [ "$#" -gt 0 ]; do
			case "$1" in
				--sync) sync=1 ;;
				--from-hook) from_hook=1 ;;
				*)
					usage >&2
					exit 64
					;;
			esac
			shift
		done
		if [ "$sync" -eq 1 ]; then
			sync_codex_skills
		else
			install_missing_codex_skills
		fi
		if [ "$sync" -eq 1 ] && [ "$from_hook" -eq 0 ]; then
			configure_repo_hooks
		fi
		exit 0
		;;
	--sync|--from-hook)
		printf '%s requires --codex\n' "$1" >&2
		exit 64
		;;
    --claude) ;;
    *)
        usage >&2
        exit 64
        ;;
esac

TARGET="$HOME/.claude/skills"
TS="$(date +%Y%m%d-%H%M%S)"
BAK="$TARGET.bak.$TS"

# Detect the current state of $TARGET so we can describe an accurate plan.
#   kind: none | symlink-self | symlink-other | directory | file
kind="none"
detail=""
if [ -L "$TARGET" ]; then
    detail="$(readlink "$TARGET")"
    if [ "$detail" = "$SCRIPT_DIR" ]; then
        kind="symlink-self"
    else
        kind="symlink-other"
    fi
elif [ -d "$TARGET" ]; then
    kind="directory"
elif [ -e "$TARGET" ]; then
    kind="file"
fi

# Print the plan.
printf '\n'
printf 'llm_skills installer\n'
printf '====================\n'
printf 'Source (this repo):  %s\n' "$SCRIPT_DIR"
printf 'Target symlink:      %s\n' "$TARGET"
printf '\n'
printf 'Plan:\n'

case "$kind" in
    none)
        printf '  - %s does not exist.\n' "$TARGET"
        if [ ! -d "$HOME/.claude" ]; then
            printf '  - Will create parent directory: %s\n' "$HOME/.claude"
        fi
        printf '  - Will create symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
        ;;
    symlink-self)
        printf '  - %s is already a symlink to this repo.\n' "$TARGET"
        printf '  - Nothing to do.\n\n'
        printf 'Already installed. Exiting.\n'
        exit 0
        ;;
    symlink-other)
        printf '  - %s is a symlink pointing to:\n' "$TARGET"
        printf '        %s\n' "$detail"
        printf '  - Will rename the existing symlink to: %s\n' "$BAK"
        printf '  - Will create a new symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
        ;;
    directory)
        printf '  - %s is a real directory (not a symlink).\n' "$TARGET"
        printf '  - Will rename it to:       %s\n' "$BAK"
        printf '    (preserves any locally-authored skills outside this repo)\n'
        printf '  - Will create a new symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
        ;;
    file)
        printf '  - %s is an unexpected file (not a directory, not a symlink).\n' "$TARGET"
        printf '  - Will rename it to:       %s\n' "$BAK"
        printf '  - Will create a new symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
        ;;
esac

printf '\n'
printf 'Proceed? [y/N] '
read -r reply
case "${reply:-}" in
    y|Y|yes|YES) ;;
    *)
        printf 'Aborted.\n' >&2
        exit 1
        ;;
esac

# Execute.
if [ ! -d "$HOME/.claude" ]; then
    mkdir -p "$HOME/.claude"
    printf 'Created %s\n' "$HOME/.claude"
fi

if [ -L "$TARGET" ] || [ -e "$TARGET" ]; then
    mv "$TARGET" "$BAK"
    printf 'Moved %s -> %s\n' "$TARGET" "$BAK"
fi

ln -s "$SCRIPT_DIR" "$TARGET"
printf 'Created symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
printf '\nDone. Claude Code (and any agent harness reading %s) will now\n' "$TARGET"
printf 'pick up skills from this repo.\n'
