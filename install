#!/usr/bin/env bash
# install — install this llm_skills clone for local agent harnesses.
#
# Default: symlink this clone to ~/.claude/skills for Claude Code.
# Codex: run `./install --codex`; current Codex releases discover user skills
# from ~/.agents/skills and follow its link to this one physical repository.

set -uo pipefail
set -E
trap 'printf "\ninstall: failure on line %s\n" "$LINENO" >&2; exit 1' ERR

# Resolve the real directory of this script, regardless of where it was
# invoked from (and even if the caller used a symlink).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

usage() {
    cat <<EOF
Usage: ./install [--claude|--codex|--help]

  --claude  Symlink this repo to ~/.claude/skills (default)
  --codex   Symlink this repo to ~/.agents/skills and archive legacy copies
EOF
}

BACKUP_ROOT=''

ensure_backup_root() {
	local backup_parent="$HOME/.codex/backups"
	if [ -n "$BACKUP_ROOT" ]; then
		return 0
	fi
	mkdir -p "$backup_parent"
	BACKUP_ROOT="$(mktemp -d "$backup_parent/llm-skills-zero-copy.XXXXXX")"
}

target_points_to_repo() {
	local target="$1" resolved
	if [ ! -L "$target" ] || [ ! -d "$target" ]; then
		return 1
	fi
	resolved="$(cd "$target" && pwd -P)" || return 1
	[ "$resolved" = "$SCRIPT_DIR" ]
}

repo_owns_skill_name() {
	local name="$1" source="$SCRIPT_DIR/$1"
	[ -f "$source/SKILL.md" ] || [ -L "$source/SKILL.md" ] || [ -L "$source" ]
}

retire_copy_sync_hook_config() {
	local hooks_path=''
	if ! git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		printf 'No repository-local copy-sync hook configuration found.\n'
		return 0
	fi
	hooks_path="$(git -C "$SCRIPT_DIR" config --local --get core.hooksPath 2>/dev/null || true)"
	if [ "$hooks_path" = '.githooks' ]; then
		git -C "$SCRIPT_DIR" config --local --unset-all core.hooksPath
		printf 'Retired copy-sync Git hook configuration from %s/.git/config\n' "$SCRIPT_DIR"
	elif [ -n "$hooks_path" ]; then
		printf 'Preserved unrelated repository hook path: %s\n' "$hooks_path"
	else
		printf 'Copy-sync Git hook configuration was already retired.\n'
	fi
}

install_codex_zero_copy() {
	local target="$HOME/.agents/skills"
	local target_parent="$HOME/.agents"
	local legacy_target="$HOME/.codex/skills"
	local existing name source link_staging
	local target_backed_up=0 archived=0 failed=0

	if [ -z "${HOME:-}" ]; then
		printf 'HOME must be non-empty\n' >&2
		return 1
	fi

	printf '\n'
	printf 'llm_skills Codex installer\n'
	printf '==========================\n'
	printf 'Source repository: %s\n' "$SCRIPT_DIR"
	printf 'User skill root:   %s\n' "$target"
	printf 'Mode: zero-copy\n'
	printf '\n'
	printf 'Plan:\n'
	printf '  - Point %s directly to this physical repository.\n' "$target"
	printf '  - Archive only legacy Codex skill names owned by this repository.\n'
	printf '  - Preserve Codex system and unrelated local-only skills in place.\n'
	printf '  - Retire this repository\047s obsolete copy-sync hook setting.\n'
	printf '\n'
	printf 'Proceed? [y/N] '
	read -r reply
	case "${reply:-}" in
		y|Y|yes|YES) ;;
		*)
			printf 'Aborted.\n' >&2
			return 1
			;;
	esac

	if target_points_to_repo "$target"; then
		printf 'User skill root already points to this repository.\n'
	else
		if [ -e "$target" ] || [ -L "$target" ]; then
			ensure_backup_root
			if mv "$target" "$BACKUP_ROOT/agents-skills"; then
				target_backed_up=1
				printf 'Archived previous user skill root.\n'
			else
				printf 'Failed to archive previous user skill root: %s\n' "$target" >&2
				return 1
			fi
		fi

		mkdir -p "$target_parent"
		link_staging="$(mktemp -d "$target_parent/.skills-link.XXXXXX")"
		rmdir "$link_staging"
		if ! ln -s "$SCRIPT_DIR" "$link_staging" || ! mv "$link_staging" "$target"; then
			if [ -L "$link_staging" ]; then
				unlink "$link_staging"
			fi
			if [ "$target_backed_up" -eq 1 ] && [ ! -e "$target" ] && [ ! -L "$target" ]; then
				mv "$BACKUP_ROOT/agents-skills" "$target"
			fi
			printf 'Failed to install user skill root link: %s\n' "$target" >&2
			return 1
		fi
		printf 'Linked user skill root to this repository.\n'
	fi

	if [ -d "$legacy_target" ]; then
		while IFS= read -r existing; do
			name=${existing##*/}
			if ! repo_owns_skill_name "$name"; then
				continue
			fi
			ensure_backup_root
			mkdir -p "$BACKUP_ROOT/legacy-codex-skills"
			if mv "$existing" "$BACKUP_ROOT/legacy-codex-skills/$name"; then
				printf 'Archived duplicate legacy skill: %s\n' "$name"
				archived=$((archived + 1))
			else
				printf 'Failed to archive duplicate legacy skill: %s\n' "$name" >&2
				failed=$((failed + 1))
			fi
		done < <(command find "$legacy_target" -mindepth 1 -maxdepth 1 -exec printf '%s\n' '{}' \; | sort)
	fi

	retire_copy_sync_hook_config
	printf '\nSummary: linked=1 archived=%d failed=%d\n' "$archived" "$failed"
	if [ -n "$BACKUP_ROOT" ]; then
		printf 'Recoverable previous state: %s\n' "$BACKUP_ROOT"
	fi
	if [ "$failed" -ne 0 ]; then
		return 1
	fi
	printf 'Done. Codex detects skill changes automatically; restart if its UI remains stale.\n'
}

case "${1:---claude}" in
	--help|-h)
		usage
		exit 0
		;;
	--codex)
		shift
		if [ "$#" -ne 0 ]; then
			case "${1:-}" in
				--sync|--from-hook)
					printf "%s is retired; current Codex uses the zero-copy \$HOME/.agents/skills link.\n" "$1" >&2
					;;
				*) usage >&2 ;;
			esac
			exit 64
		fi
		install_codex_zero_copy
		exit 0
		;;
	--sync|--from-hook)
		printf "%s is retired; current Codex uses the zero-copy \$HOME/.agents/skills link.\n" "$1" >&2
		exit 64
		;;
    --claude) ;;
    *)
        usage >&2
        exit 64
        ;;
esac

TARGET="$HOME/.claude/skills"
TS="$(date +%Y%m%d-%H%M%S)"
BAK="$TARGET.bak.$TS"

# Detect the current state of $TARGET so we can describe an accurate plan.
#   kind: none | symlink-self | symlink-other | directory | file
kind="none"
detail=""
if [ -L "$TARGET" ]; then
    detail="$(readlink "$TARGET")"
    if [ "$detail" = "$SCRIPT_DIR" ]; then
        kind="symlink-self"
    else
        kind="symlink-other"
    fi
elif [ -d "$TARGET" ]; then
    kind="directory"
elif [ -e "$TARGET" ]; then
    kind="file"
fi

# Print the plan.
printf '\n'
printf 'llm_skills installer\n'
printf '====================\n'
printf 'Source (this repo):  %s\n' "$SCRIPT_DIR"
printf 'Target symlink:      %s\n' "$TARGET"
printf '\n'
printf 'Plan:\n'

case "$kind" in
    none)
        printf '  - %s does not exist.\n' "$TARGET"
        if [ ! -d "$HOME/.claude" ]; then
            printf '  - Will create parent directory: %s\n' "$HOME/.claude"
        fi
        printf '  - Will create symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
        ;;
    symlink-self)
        printf '  - %s is already a symlink to this repo.\n' "$TARGET"
        printf '  - Nothing to do.\n\n'
        printf 'Already installed. Exiting.\n'
        exit 0
        ;;
    symlink-other)
        printf '  - %s is a symlink pointing to:\n' "$TARGET"
        printf '        %s\n' "$detail"
        printf '  - Will rename the existing symlink to: %s\n' "$BAK"
        printf '  - Will create a new symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
        ;;
    directory)
        printf '  - %s is a real directory (not a symlink).\n' "$TARGET"
        printf '  - Will rename it to:       %s\n' "$BAK"
        printf '    (preserves any locally-authored skills outside this repo)\n'
        printf '  - Will create a new symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
        ;;
    file)
        printf '  - %s is an unexpected file (not a directory, not a symlink).\n' "$TARGET"
        printf '  - Will rename it to:       %s\n' "$BAK"
        printf '  - Will create a new symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
        ;;
esac

printf '\n'
printf 'Proceed? [y/N] '
read -r reply
case "${reply:-}" in
    y|Y|yes|YES) ;;
    *)
        printf 'Aborted.\n' >&2
        exit 1
        ;;
esac

# Execute.
if [ ! -d "$HOME/.claude" ]; then
    mkdir -p "$HOME/.claude"
    printf 'Created %s\n' "$HOME/.claude"
fi

if [ -L "$TARGET" ] || [ -e "$TARGET" ]; then
    mv "$TARGET" "$BAK"
    printf 'Moved %s -> %s\n' "$TARGET" "$BAK"
fi

ln -s "$SCRIPT_DIR" "$TARGET"
printf 'Created symlink: %s -> %s\n' "$TARGET" "$SCRIPT_DIR"
printf '\nDone. Claude Code (and any agent harness reading %s) will now\n' "$TARGET"
printf 'pick up skills from this repo.\n'
